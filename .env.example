# ========================================
# StyleStore email API environment.
# Copy this file to .env and fill in REAL values.
# Never commit .env — it is gitignored.
# ========================================

# Gmail account that sends the welcome emails.
# Use a dedicated Gmail account for the newsletter if possible.
SMTP_USER=your-gmail-address@gmail.com

# Google App Password (16 characters) created under
# Google Account -> Security -> 2-Step Verification -> App passwords.
# NOT your normal Gmail password.
SMTP_APP_PASSWORD=your-16-character-google-app-password

# Allowed frontend origin(s) for CORS. Comma-separated for multiple:
# CLIENT_ORIGINS=http://localhost:5173,https://your-frontend-domain.example
CLIENT_ORIGINS=http://localhost:5173

# Port the Express API listens on.
PORT=3001

# Optional for a separately hosted frontend. Leave blank for the Vite proxy.
VITE_API_URL=

# ========================================
# MySQL / MariaDB details for the checkout database.
# Point these at your XAMPP MySQL server.
# ========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=mystylestore_db

# Admin access. Never put a real password in frontend code or Git.
# Generate a hash with: npm run hash-admin-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Use lax for same-site proxying; use none only with an HTTPS cross-site frontend.
ADMIN_COOKIE_SAME_SITE=lax
# ADMIN_PASSWORD is accepted only outside production for local testing.
# ADMIN_PASSWORD=local-only-password